            <div class="category-name">Residential</div>
        </div>

        <div class="category"
             onclick="openCategory('customization', this)">
            <div class="icon">🛠</div>
            <div class="category-name">Customization</div>
        </div>

        <div class="category"
             onclick="openCategory('agriculture', this)">
            <div class="icon">🌾</div>
            <div class="category-name">Agriculture</div>
        </div>

        <div class="category"
             onclick="openCategory('castle', this)">
            <div class="icon">🏰</div>
            <div class="category-name">Castle</div>
        </div>

        <div class="category"
             onclick="openCategory('military', this)">
            <div class="icon">⚔</div>
            <div class="category-name">Military</div>
        </div>

        <div class="category"
             onclick="openCategory('infrastructure', this)">
