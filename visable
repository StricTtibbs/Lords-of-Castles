        <div class="stat-icon">💰</div>

        <div class="stat-info">
            <div class="stat-name">Treasury</div>
            <div class="stat-value">1,250 GC</div>
        </div>

        <div class="tooltip">
            <div class="tooltip-title">Treasury</div>
            Available settlement funds:
            <strong>1,250 GC</strong>.
            <br><br>
            Used for construction, wages,
            trade and other expenses.
        </div>

    </div>


    <!-- Animals -->
    <div class="stat">

        <div class="stat-icon">🐄</div>

        <div class="stat-info">
            <div class="stat-name">Animals</div>
