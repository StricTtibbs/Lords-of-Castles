        </div>

    </div>


    <!-- Firewood -->
    <div class="stat">

        <div class="stat-icon">🪵</div>

        <div class="stat-info">
            <div class="stat-name">Firewood</div>
            <div class="stat-value">5 months</div>
        </div>

        <div class="tooltip">
            <div class="tooltip-title">Firewood Supply</div>

            Current supply:
            <strong>5 months</strong>
            <br><br>

            Consumption changes depending on
