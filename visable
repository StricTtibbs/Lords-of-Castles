    </div>

    <div class="ornament">
        ◆ ───────────── ◆
    </div>

</div>


<script>

/* =========================================================
   BUILDING CATEGORIES
========================================================= */

const categories = {

    industry: {
        name: "Industry",
        buildings: [
            ["⚒", "Blacksmith"],
            ["🪵", "Sawmill"],
            ["⛏", "Stonecutter"],
            ["🔥", "Forge"],
            ["🏭", "Workshop"]
        ]
    },

    residential: {
        name: "Residential",
        buildings: [
            ["🏠", "Peasant House"],
            ["🏡", "Cottage"],
            ["🏘", "Townhouse"],
            ["🏰", "Manor House"],
            ["🏛", "Noble Residence"]
        ]
    },

    customization: {
        name: "Customization",
        buildings: [
            ["🌳", "Trees"],
            ["🌲", "Pine Trees"],
            ["🪨", "Rocks"],
            ["🌿", "Bushes"],
            ["⛲", "Decoration"]
        ]
    },

    agriculture: {
        name: "Agriculture",
        buildings: [
            ["🌾", "Wheat Field"],
            ["🥕", "Vegetable Field"],
            ["🐄", "Cattle Farm"],
            ["🐑", "Sheep Farm"],
            ["🌻", "Herb Garden"]
        ]
    },

    castle: {
        name: "Castle & Settlement",
        buildings: [
            ["🏰", "Castle Keep"],
            ["🧱", "Castle Wall"],
            ["🚪", "Gatehouse"],
            ["🗼", "Watchtower"],
            ["🏘", "Settlement Centre"]
        ]
    },

    military: {
        name: "Military",
        buildings: [
            ["⚔", "Barracks"],
            ["🏹", "Archery Range"],
            ["🐎", "Stable"],
            ["🛡", "Armoury"],
            ["⚔", "Training Yard"]
        ]
    },

    infrastructure: {
        name: "Infrastructure",
        buildings: [
            ["🛣", "Road"],
            ["🌉", "Bridge"],
            ["🚰", "Well"],
            ["📦", "Storage"],
            ["🏪", "Market"]
        ]
    }

};


/* =========================================================
   OPEN BUILDING CATEGORY
========================================================= */

function openCategory(category, element) {

    document.querySelectorAll(".category")
        .forEach(button =>
            button.classList.remove("active")
        );

    element.classList.add("active");

    const data = categories[category];

    document.getElementById("optionsTitle").innerText =
        data.name;

    const container =
        document.getElementById("buildingOptions");

    container.innerHTML = "";

    data.buildings.forEach(building => {

        const div = document.createElement("div");

        div.className = "building";

        div.innerHTML = `
            <div class="building-icon">
                ${building[0]}
            </div>

            <div class="building-name">
                ${building[1]}
            </div>
        `;

        div.onclick = () => {
            alert("Selected: " + building[1]);
        };

        container.appendChild(div);

    });

    document
        .getElementById("optionsPanel")
        .classList.add("show");
}


/* =========================================================
   FAMILY DATA
   1 HOUSE = 1 FAMILY
========================================================= */

let settlement = {

    families: 126,

    houses: 140,

    occupiedHomes: 126,

    freeFamilies: 0

};


/* =========================================================
   UPDATE FAMILY INFORMATION
========================================================= */

function updateFamilies() {

    settlement.occupiedHomes =
        Math.min(
            settlement.families,
            settlement.houses
        );

    settlement.freeFamilies =
        Math.max(
            0,
            settlement.families -
            settlement.houses
        );

    const emptyHomes =
        Math.max(
            0,
            settlement.houses -
            settlement.families
        );

    document.getElementById("families").innerText =
        settlement.families;

    document.getElementById("tipFamilies").innerText =
        settlement.families;

    document.getElementById("tipFreeFamilies").innerText =
        settlement.freeFamilies;

    document.getElementById("tipOccupiedHomes").innerText =
        settlement.occupiedHomes;

    document.getElementById("tipEmptyHomes").innerText =
        emptyHomes;
}


