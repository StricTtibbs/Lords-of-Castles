    UPROPERTY(EditAnywhere, Category="Placement")
    float GridSize = 50.0f;

    UPROPERTY(EditAnywhere, Category="Placement")
    float RotationAmount = 15.0f;

    UPROPERTY(EditAnywhere, Category="Placement")
    float GroundOffset = 2.0f;


    // =========================================================
