// MedievalHouse.cpp

#include "MedievalHouse.h"

AMedievalHouse::AMedievalHouse()
{
    PrimaryActorTick.bCanEverTick = false;

    Backyard = nullptr;
}

void AMedievalHouse::BeginPlay()
{
    Super::BeginPlay();

    HasBackyard =
        QualifiesForBackyard();
}

bool AMedievalHouse::QualifiesForBackyard() const
{
    /*
       Large houses and manors have
       enough land for private production.
    */

    return
        HouseSize == EHouseSize::Large ||
        HouseSize == EHouseSize::Manor;
}

ABackyardExtension*
AMedievalHouse::CreateBackyardExtension(
    EProductionType Type
)
{
    if (!QualifiesForBackyard())
    {
        return nullptr;
    }

    if (Backyard != nullptr)
    {
        return Backyard;
    }

    FActorSpawnParameters Params;

    Params.Owner = this;

    Backyard =
        GetWorld()->SpawnActor<ABackyardExtension>(
            ABackyardExtension::StaticClass(),
            GetActorLocation(),
            GetActorRotation(),
            Params
        );

    if (Backyard)
    {
        Backyard->BackyardArea =
            BackyardArea;

        Backyard->ProductionType =
            Type;

        Backyard->CalculateProductionMultiplier();
    }

    return Backyard;
}


