The worker's state machine becomes:

IDLE
 ↓
WALK TO STOCKPILE
 ↓
LOAD RESOURCE
 ↓
PICK UP LOG / STONE / IRON / FLAX
 ↓
CARRY RESOURCE
 ↓
WALK TO DESTINATION
 ↓
UNLOAD
 ↓
RESOURCE ENTERS BUILDING INVENTORY
 ↓
RETURN TO STOCKPILE
 ↓
REPEAT

For example:

void AResourceCarrier::LoadResource()
{
    if (!CurrentStockpile)
        return;

    CarriedItem =
        EItemType::Logs;

    CarriedAmount =
        FMath::Min(
            CarryCapacity,
            1
        );

    WorkerState =
        EWorkerState::CarryingResource;

    UpdateWorkerAnimation();
}

void AResourceCarrier::DeliverResource()
{
    if (!CurrentConstructionSite)
        return;

    if (CarriedAmount <= 0)
        return;

    /*
       Send the resource into the
       construction site's inventory.
    */

    // ConstructionSite->ReceiveMaterial(
    //     CarriedItem,
    //     CarriedAmount
    // );

    CarriedAmount = 0;

    CarriedItem =
        EItemType::None;

    WorkerState =
        EWorkerState::ReturningHome;

    UpdateWorkerAnimation();
}

