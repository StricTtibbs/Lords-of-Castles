#include "MedievalProductionBuilding.h"

AMedievalProductionBuilding::AMedievalProductionBuilding()
{
    PrimaryActorTick.bCanEverTick = true;
}

void AMedievalProductionBuilding::BeginPlay()
{
    Super::BeginPlay();

    SetupRecipes();
}

void AMedievalProductionBuilding::Tick(
    float DeltaTime
)
{
    Super::Tick(DeltaTime);

    if (CurrentRecipe < 0)
        return;

    if (Workers <= 0)
        return;

    FProductionRecipe* Recipe =
        GetCurrentRecipe();

    if (!Recipe)
        return;

    CurrentProductionTime +=
        DeltaTime *
        ProductionSpeed *
        FMath::Max(1, Workers);

    if (CurrentProductionTime >=
        Recipe->ProductionTime)
    {
        CompleteRecipe();
    }
}

void AMedievalProductionBuilding::SetupRecipes()
{
    Recipes.Empty();

    if (ProductionType ==
        EProductionType::Blacksmith)
    {
        FProductionRecipe Sword;

        Sword.RecipeName =
            TEXT("Forge Sword");

        Sword.Inputs = {

            { EItemType::Iron, 2 },
            { EItemType::Planks, 1 }

        };

        Sword.Outputs = {

            { EItemType::Swords, 1 }

        };

        Sword.ProductionTime = 45.0f;

        Recipes.Add(Sword);


        FProductionRecipe Spear;

        Spear.RecipeName =
            TEXT("Forge Spear");

        Spear.Inputs = {

            { EItemType::Iron, 1 },
            { EItemType::Planks, 1 }

        };

        Spear.Outputs = {

            { EItemType::Spears, 2 }

        };

        Spear.ProductionTime = 25.0f;

        Recipes.Add(Spear);


        FProductionRecipe Halberd;

        Halberd.RecipeName =
            TEXT("Forge Halberd");

        Halberd.Inputs = {

            { EItemType::Iron, 3 },
            { EItemType::Planks, 2 }

        };

        Halberd.Outputs = {

            { EItemType::Halberds, 1 }

        };

        Halberd.ProductionTime = 60.0f;

        Recipes.Add(Halberd);


        FProductionRecipe Pike;

        Pike.RecipeName =
            TEXT("Forge Pike");

        Pike.Inputs = {

            { EItemType::Iron, 1 },
            { EItemType::Planks, 2 }

        };

        Pike.Outputs = {

            { EItemType::Pikes, 1 }

        };

        Pike.ProductionTime = 40.0f;

        Recipes.Add(Pike);
    }
}

