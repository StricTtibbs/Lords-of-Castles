// BackyardExtension.cpp

#include "BackyardExtension.h"

ABackyardExtension::ABackyardExtension()
{
    PrimaryActorTick.bCanEverTick = false;
}

void ABackyardExtension::BeginPlay()
{
    Super::BeginPlay();

    CalculateProductionMultiplier();
}

bool ABackyardExtension::CanBuildExtension() const
{
    return BackyardArea >= RequiredArea;
}

void ABackyardExtension::CalculateProductionMultiplier()
{
    if (RequiredArea <= 0.0f)
    {
        ProductionMultiplier = 1.0f;
        return;
    }

    ProductionMultiplier =
        FMath::Max(
            0.25f,
            BackyardArea / RequiredArea
        );
}

float ABackyardExtension::GetProductionMultiplier() const
{
    return ProductionMultiplier;
}
