/* =========================================================
   BUILDING SELECTION
========================================================= */

const buttons =
    document.querySelectorAll(
        ".buildButton"
    );


buttons.forEach(button=>{

    button.addEventListener(
        "click",
        ()=>{

            buttons.forEach(
                b=>
                b.classList.remove(
                    "selected"
                )
            );

            button.classList.add(
                "selected"
            );

            state.selectedBuilding =
                button.dataset.building;

            showMessage(
                "Place your "+
                state.selectedBuilding
            );

        }
    );

});


/* =========================================================
   BUILDING PLACEMENT
========================================================= */

document.addEventListener(
    "click",
    e=>{

        if(
            !state.selectedBuilding
        )
            return;


        if(
            e.target.closest(
                "#buildMenu"
            ) ||
            e.target.closest(
                "#hud"
            ) ||
            e.target.closest(
                "#controls"
            ) ||
            e.target.closest(
                "#banner"
            )
        )
            return;


        createBuilding(
            e.clientX,
            e.clientY,
            state.selectedBuilding
        );

    }
);


/* =========================================================
   DETAILED BUILDING
========================================================= */

function createBuilding(
    x,
    y,
    type
){

    const building =
        document.createElement("div");

    building.className=
        "building";

    building.style.left=
        x+"px";

    building.style.top=
        y+"px";

    building.style.transform=
        `
        translate(-50%,-50%)
        rotate(
            ${state.structureRotation}deg
        )
        `;


    /* foundation */

    const foundation =
        document.createElement("div");

    foundation.className=
        "foundation";


    /* wall */

    const wall =
        document.createElement("div");

    wall.className=
        "wall";


    /* roof */

    const roof =
        document.createElement("div");

    roof.className=
        "roof";


    /* door */

    const door =
        document.createElement("div");

    door.className=
        "door";


    /* windows */

    const windowLeft =
        document.createElement("div");

    windowLeft.className=
        "window left";


    const windowRight =
        document.createElement("div");

    windowRight.className=
        "window right";


    /* timber */

    const v1 =
        document.createElement("div");

    v1.className=
        "beam vertical1";


    const v2 =
        document.createElement("div");

    v2.className=
        "beam vertical2";


    const horizontal =
        document.createElement("div");

    horizontal.className=
        "beam horizontal";


    const diagonal1 =
        document.createElement("div");

    diagonal1.className=
        "beam diagonal1";


    const diagonal2 =
        document.createElement("div");

    diagonal2.className=
        "beam diagonal2";


    /* chimney */

    const chimney =
        document.createElement("div");

    chimney.className=
        "chimney";


    building.appendChild(
        foundation
    );

    building.appendChild(
        wall
    );

    building.appendChild(
        roof
    );

    building.appendChild(
        door
    );

    building.appendChild(
        windowLeft
    );

    building.appendChild(
        windowRight
    );

    building.appendChild(
        v1
    );

    building.appendChild(
        v2
    );

    building.appendChild(
        horizontal
    );

    building.appendChild(
        diagonal1
    );

    building.appendChild(
        diagonal2
    );

    building.appendChild(
        chimney
    );


    /* building-specific appearance */

    if(type==="Granary"){

        building.style.transform+=
            " scale(1.08)";

        roof.style.background=
            "linear-gradient(150deg,#6d4d2d,#986e3c,#49301e)";

    }


    if(type==="Storehouse"){

        wall.style.background=
            "linear-gradient(90deg,#806c52,#a28b68,#665541)";

    }


    if(type==="Blacksmith"){

        chimney.style.height="60px";

        chimney.style.background=
            "#4a4640";

    }


    if(type==="Barracks"){

        building.style.transform+=
            " scale(1.25)";

    }


    terrain.appendChild(
        building
    );


    state.selectedBuilding=null;

    buttons.forEach(
        b=>
        b.classList.remove(
            "selected"
        )
    );


    showMessage(
        type+
        " foundation placed"
    );

}


/* =========================================================
   ROTATE STRUCTURE
========================================================= */

function rotateStructure(){

    if(
        !state.selectedBuilding
    )
        return;


    state.structureRotation+=15;


    if(
        state.structureRotation>=360
    ){

        state.structureRotation=0;

    }


    showMessage(
        "Structure rotation: "+
        state.structureRotation+
        "°"
    );

}


/* =========================================================
   MAP
========================================================= */

function toggleMap(){

    const map =
        document.getElementById(
            "map"
        );

    map.style.display =
        map.style.display==="flex"
        ? "none"
        : "flex";

}


document
    .getElementById("closeMap")
    .onclick=()=>{

        document
            .getElementById("map")
            .style.display="none";

    };


/* =========================================================
   MILITIA
========================================================= */

document
    .getElementById(
        "militiaButton"
    )
    .onclick=()=>{

        if(state.population<20){

            showMessage(
                "You need 20 people to raise the militia."
            );

            return;

        }


        if(state.shields<=0){

            showMessage(
                "You need shields."
            );

            return;

        }


        if(state.spears<=0){

            showMessage(
                "You need spears."
            );

            return;

        }


        state.militia++;

        state.population-=20;

        state.shields--;

        state.spears--;

        updateHUD();

        showMessage(
            "Militia raised."
        );

    };


