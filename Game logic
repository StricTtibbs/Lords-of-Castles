/* =========================================================
   TERRAIN GENERATION
========================================================= */

const terrain =
    document.getElementById("terrain");


function random(min,max){

    return Math.random()
        *(max-min)+min;

}


/* =========================================================
   GRASS
========================================================= */

for(let i=0;i<1500;i++){

    const grass =
        document.createElement("div");

    grass.className="grass";

    grass.style.left =
        random(0,100)+"%";

    grass.style.top =
        random(0,100)+"%";

    grass.style.setProperty(
        "--wind",
        random(3,12)
    );

    grass.style.setProperty(
        "--speed",
        random(1.5,4)+"s"
    );

    terrain.appendChild(grass);

}


/* =========================================================
