/* =========================================================
   CAMERA
========================================================= */

const keys={};


document.addEventListener(
    "keydown",
    e=>{

        const k =
            e.key.toLowerCase();

        keys[k]=true;


        if(
            [
                "w","a","s",
                "d","c","q",
                "e","r","m"
            ].includes(k)
        ){

            e.preventDefault();

        }


        if(k==="r" && !e.repeat){

            rotateStructure();

        }


        if(k==="m" && !e.repeat){

            toggleMap();

        }

    }
);


document.addEventListener(
    "keyup",
    e=>{

        keys[
            e.key.toLowerCase()
        ]=false;

    }
);


function cameraUpdate(){

    if(keys.w)
        state.cameraY+=8;

    if(keys.c)
        state.cameraY-=8;

    if(keys.a)
        state.cameraX+=8;

    if(keys.d)
        state.cameraX-=8;

    if(keys.q)
        state.cameraRotation-=1.5;

    if(keys.e)
        state.cameraRotation+=1.5;


    terrain.style.transform=
        `
        translate(
            ${state.cameraX}px,
            ${state.cameraY}px
        )
        rotate(
            ${state.cameraRotation}deg
        )
        `;


    requestAnimationFrame(
        cameraUpdate
    );

}


cameraUpdate();


