/* =========================================================
   MESSAGE
========================================================= */

let messageTimer;


function showMessage(text){

    const message =
        document.getElementById(
            "message"
        );

    message.textContent=text;

    message.style.display="block";

    clearTimeout(
        messageTimer
    );

    messageTimer=
        setTimeout(
            ()=>{
                message.style.display=
                    "none";
            },
            1800
        );

}
