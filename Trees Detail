AMedievalTree::AMedievalTree()
{
    PrimaryActorTick.bCanEverTick = true;


    // ========================================================
    // ROOT
    // ========================================================

    Root =
        CreateDefaultSubobject<USceneComponent>(
            TEXT("TreeRoot")
        );

    SetRootComponent(Root);


    // ========================================================
    // TRUNK
    // ========================================================

    Trunk =
        CreateDefaultSubobject<UStaticMeshComponent>(
            TEXT("Trunk")
        );

    Trunk->SetupAttachment(Root);


    // ========================================================
    // BRANCHES
    // ========================================================

    Branches =
        CreateDefaultSubobject<
            UHierarchicalInstancedStaticMeshComponent
        >(
            TEXT("Branches")
        );

    Branches->SetupAttachment(Root);


    // ========================================================
    // LEAVES
    // ========================================================

    Leaves =
        CreateDefaultSubobject<
            UHierarchicalInstancedStaticMeshComponent
        >(
            TEXT("Leaves")
        );

    Leaves->SetupAttachment(Root);


    // ========================================================
    // ROOTS
    // ========================================================

    Roots =
        CreateDefaultSubobject<
            UHierarchicalInstancedStaticMeshComponent
        >(
            TEXT("Roots")
        );

    Roots->SetupAttachment(Root);
}


// ============================================================
// BEGIN PLAY
// ============================================================

void AMedievalTree::BeginPlay()
{
    Super::BeginPlay();

    GenerateTree();
}


// ============================================================
// TICK
// ============================================================

void AMedievalTree::Tick(
    float DeltaSeconds
)
{
    Super::Tick(
        DeltaSeconds
    );


    // Wind animation can be driven
    // by materials for performance.

    const float Time =
        GetWorld()->GetTimeSeconds();


    const float Wind =
        FMath::Sin(Time * 0.7f) *
        TreeData.Wind.BranchMovement;


    FRotator Rotation =
        FRotator(
            Wind * 0.15f,
            0.0f,
            Wind * 0.08f
        );


    Branches->SetRelativeRotation(
        Rotation
    );
}


// ============================================================
// COMPLETE GENERATION
// ============================================================

void AMedievalTree::GenerateTree()
{
    DetermineAge();

    GenerateTrunk();

    GenerateRoots();

    GenerateBranches();

    GenerateLeaves();
}


// ============================================================
// TREE SCALE
// ============================================================

float AMedievalTree::GetTreeScale() const
{
    const float Minimum =
        TreeData.Dimensions.MinimumHeight;

    const float Maximum =
        TreeData.Dimensions.MaximumHeight;

    const float Height =
        FMath::FRandRange(
            Minimum,
            Maximum
        );

    return Height / 10.0f;
}


// ============================================================
// TRUNK
// ============================================================

void AMedievalTree::GenerateTrunk()
{
    if (!Trunk)
        return;


    const float Radius =
        FMath::FRandRange(
            TreeData.Dimensions.MinimumTrunkRadius,
            TreeData.Dimensions.MaximumTrunkRadius
        );


    const float Height =
        FMath::FRandRange(
            TreeData.Dimensions.MinimumHeight,
            TreeData.Dimensions.MaximumHeight
        );


    const float AgeMultiplier =
        FMath::Clamp(
            TreeAgeYears /
            TreeData.Growth.MatureAge,
            0.35f,
            1.0f
        );


    Trunk->SetRelativeScale3D(
        FVector(
            Radius * AgeMultiplier,
            Radius * AgeMultiplier,
            Height
        )
    );
}


// ============================================================
// BRANCHES
// ============================================================

void AMedievalTree::GenerateBranches()
{
    if (!Branches)
        return;


    Branches->ClearInstances();


    const int32 Count =
        FMath::RandRange(
            TreeData.Dimensions.MinimumBranches,
            TreeData.Dimensions.MaximumBranches
        );


    const float Height =
        FMath::FRandRange(
            TreeData.Dimensions.MinimumHeight,
            TreeData.Dimensions.MaximumHeight
        );


    for (
        int32 Index = 0;
        Index < Count;
        ++Index
    )
    {
        const float HeightPercent =
            FMath::FRandRange(
                0.35f,
                0.95f
            );


        const FVector Location(
            0.0f,
            0.0f,
            Height *
            HeightPercent
        );


        const FVector Direction =
            GenerateBranchDirection(
                Index
            );


        FRotator Rotation =
            Direction.Rotation();


        Rotation.Pitch +=
            FMath::FRandRange(
                -15.0f,
                15.0f
            );


        const float Length =
            FMath::FRandRange(
                0.5f,
                2.5f
            );


        FTransform Transform;

        Transform.SetLocation(
            Location
        );

        Transform.SetRotation(
            Rotation.Quaternion()
        );

        Transform.SetScale3D(
            FVector(
                Length,
                0.15f,
                0.15f
            )
        );


        Branches->AddInstance(
            Transform
        );
    }
}


// ============================================================
// BRANCH DIRECTION
// ============================================================

FVector AMedievalTree::GenerateBranchDirection(
    int32 Index
) const
{
    const float Angle =
        (
            static_cast<float>(Index)
            /
            FMath::Max(
                1,
                TreeData.Branches.PrimaryBranches
            )
        )
        *
        360.0f;


    const float Radians =
        FMath::DegreesToRadians(
            Angle
        );


    const float X =
        FMath::Cos(Radians);

    const float Y =
        FMath::Sin(Radians);


    return FVector(
        X,
        Y,
        FMath::FRandRange(
            0.15f,
            0.65f
        )
    ).GetSafeNormal();
}


// ============================================================
// ROOTS
// ============================================================

void AMedievalTree::GenerateRoots()
{
    if (!Roots)
        return;


    Roots->ClearInstances();


    for (
        int32 Index = 0;
        Index < TreeData.Roots.MajorRoots;
        ++Index
    )
    {
        const float Angle =
            (
                static_cast<float>(Index)
                /
                TreeData.Roots.MajorRoots
            )
            *
            360.0f;


        const float Radians =
            FMath::DegreesToRadians(
                Angle
            );


        FVector Direction(
            FMath::Cos(Radians),
            FMath::Sin(Radians),
            -0.15f
        );


        Direction.Normalize();


        FTransform Transform;


        Transform.SetLocation(
            FVector(
                0.0f,
                0.0f,
                0.15f
            )
        );


        Transform.SetRotation(
            Direction.Rotation()
                .Quaternion()
        );


        Transform.SetScale3D(
            FVector(
                TreeData.Roots.RootSpread,
                0.15f,
                0.15f
            )
        );


        Roots->AddInstance(
            Transform
        );
    }
}


// ============================================================
// LEAVES
// ============================================================

void AMedievalTree::GenerateLeaves()
{
    if (!Leaves)
        return;


    Leaves->ClearInstances();


    const int32 LeafClusters =
        FMath::RoundToInt(
            100.0f *
            TreeData.Leaves.LeafDensity
        );


    const float CanopyRadius =
        FMath::FRandRange(
            TreeData.Dimensions.MinimumCanopyRadius,
            TreeData.Dimensions.MaximumCanopyRadius
        );


    const float TreeHeight =
        FMath::FRandRange(
            TreeData.Dimensions.MinimumHeight,
            TreeData.Dimensions.MaximumHeight
        );


    for (
        int32 Index = 0;
        Index < LeafClusters;
        ++Index
    )
    {
        const float Angle =
            FMath::FRandRange(
                0.0f,
                360.0f
            );


        const float Radius =
            FMath::FRandRange(
                0.0f,
                CanopyRadius
            );


        const float Radians =
            FMath::DegreesToRadians(
                Angle
            );


        FVector Location;

        Location.X =
            FMath::Cos(Radians)
            * Radius;

        Location.Y =
            FMath::Sin(Radians)
            * Radius;

        Location.Z =
            TreeHeight *
            FMath::FRandRange(
                0.55f,
                1.0f
            );


        FTransform Transform;

        Transform.SetLocation(
            Location
        );


        const float Scale =
            FMath::FRandRange(
                0.7f,
                1.3f
            )
            *
            TreeData.Leaves.LeafSize;


        Transform.SetScale3D(
            FVector(
                Scale,
                Scale,
                Scale
            )
        );


        Leaves->AddInstance(
            Transform
        );
    }
}


// ============================================================
// AGE
// ============================================================

void AMedievalTree::DetermineAge()
{
    if (
        TreeAgeYears < 5.0f
    )
    {
        Age =
            ETreeAge::Sapling;
    }

    else if (
        TreeAgeYears < 20.0f
    )
    {
        Age =
            ETreeAge::Young;
    }

    else if (
        TreeAgeYears <
        TreeData.Growth.AncientAge
    )
    {
        Age =
            ETreeAge::Mature;
    }

    else if (
        TreeAgeYears <
        TreeData.Growth.MaximumAge
    )
    {
        Age =
            ETreeAge::Old;
    }

    else
    {
        Age =
            ETreeAge::Ancient;
    }
}


// ============================================================
// GROW TREE
// ============================================================

void AMedievalTree::GrowTree(
    float Years
)
{
    if (
        Health ==
        ETreeHealth::Dead
    )
    {
        return;
    }


    TreeAgeYears += Years;


    TreeAgeYears =
        FMath::Min(
            TreeAgeYears,
            TreeData.Growth.MaximumAge
        );


    DetermineAge();

    GenerateTree();
}


// ============================================================
// SEASON
// ============================================================

void AMedievalTree::ApplySeason(
    ETreeSeason Season
)
{
    switch (Season)
    {
        case ETreeSeason::Spring:

            /*
             * New bright foliage.
             */

            break;


        case ETreeSeason::Summer:

            /*
             * Full canopy.
             */

            break;


        case ETreeSeason::Autumn:

            /*
             * Deciduous trees turn orange,
             * yellow and brown.
             */

            if (
                !TreeData.Leaves.bEvergreen
            )
            {
                // Leaf material should receive
                // autumn colour parameters.
            }

            break;


        case ETreeSeason::Winter:

            /*
             * Deciduous leaves disappear.
             * Evergreen species retain foliage.
             */

            if (
                TreeData.Leaves.bDropsLeaves
                &&
                !TreeData.Leaves.bEvergreen
            )
            {
                Leaves->SetVisibility(
                    false
                );
            }

            break;
    }
}


// ============================================================
// WIND
// ============================================================

void AMedievalTree::ApplyWind(
    FVector WindDirection,
    float WindStrength
)
{
    const float Strength =
        WindStrength *
        TreeData.Wind.WindResistance;


    const FRotator WindRotation =
        WindDirection.Rotation();


    Branches->SetRelativeRotation(
        WindRotation *
        Strength
    );


    Leaves->SetRelativeRotation(
        WindRotation *
        Strength *
        1.5f
    );
}


// ============================================================
// TREE HARVEST
// ============================================================

float AMedievalTree::FellTree()
{
    if (
        Health ==
        ETreeHealth::Dead
    )
    {
        return 0.0f;
    }


    Health =
        ETreeHealth::Dead;


    const float Yield =
        TreeData.Wood.LogYield *
        FMath::Clamp(
            TreeAgeYears /
            TreeData.Growth.MatureAge,
            0.2f,
            2.0f
        );


    return Yield;
}


