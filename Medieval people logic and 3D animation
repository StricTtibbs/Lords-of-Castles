AMedievalPerson::AMedievalPerson()
{
    PrimaryActorTick.bCanEverTick = true;


    // =========================================================
    // BODY
    // =========================================================

    BodyMesh = CreateDefaultSubobject<USkeletalMeshComponent>(
        TEXT("BodyMesh")
    );

    SetRootComponent(BodyMesh);


    // =========================================================
    // CLOTHING
    // =========================================================

    Tunic = CreateDefaultSubobject<USkeletalMeshComponent>(
        TEXT("Tunic")
    );

    Tunic->SetupAttachment(BodyMesh);


    Trousers = CreateDefaultSubobject<USkeletalMeshComponent>(
        TEXT("Trousers")
    );

    Trousers->SetupAttachment(BodyMesh);


    Boots = CreateDefaultSubobject<USkeletalMeshComponent>(
        TEXT("Boots")
    );

    Boots->SetupAttachment(BodyMesh);


    Belt = CreateDefaultSubobject<USkeletalMeshComponent>(
        TEXT("Belt")
    );

    Belt->SetupAttachment(BodyMesh);


    // =========================================================
    // HEAD
    // =========================================================

    Head = CreateDefaultSubobject<USkeletalMeshComponent>(
        TEXT("Head")
    );

    Head->SetupAttachment(BodyMesh);


    Hair = CreateDefaultSubobject<USkeletalMeshComponent>(
        TEXT("Hair")
    );

    Hair->SetupAttachment(Head);


    // =========================================================
    // ARMOUR
    // =========================================================

    Helmet = CreateDefaultSubobject<USkeletalMeshComponent>(
        TEXT("Helmet")
    );

    Helmet->SetupAttachment(BodyMesh);


    MailArmor = CreateDefaultSubobject<USkeletalMeshComponent>(
        TEXT("MailArmor")
    );

    MailArmor->SetupAttachment(BodyMesh);


    PlateArmor = CreateDefaultSubobject<USkeletalMeshComponent>(
        TEXT("PlateArmor")
    );

    PlateArmor->SetupAttachment(BodyMesh);


    // =========================================================
    // WEAPONS
    // =========================================================

    Shield = CreateDefaultSubobject<USkeletalMeshComponent>(
        TEXT("Shield")
    );

    Shield->SetupAttachment(BodyMesh);


    Weapon = CreateDefaultSubobject<USkeletalMeshComponent>(
        TEXT("Weapon")
    );

    Weapon->SetupAttachment(BodyMesh);


    // =========================================================
    // DEFAULT CHARACTER
    // =========================================================

    PersonType =
        EMedievalPersonType::Villager;

    WeaponType =
        EMilitiaWeapon::None;

    HasHelmet = false;
    HasMailArmor = false;
    HasPlateArmor = false;
    HasShield = false;


    HeightScale = 1.0f;
    BodyScale = 1.0f;

    HairStyle = 0;
    FaceVariation = 0;
    ClothingVariation = 0;
}


// =============================================================
// BEGIN PLAY
// =============================================================

void AMedievalPerson::BeginPlay()
{
    Super::BeginPlay();

    UpdateAppearance();
}


// =============================================================
// TICK
// =============================================================

void AMedievalPerson::Tick(float DeltaTime)
{
    Super::Tick(DeltaTime);
}


// =============================================================
// BECOME MILITIA
// =============================================================

void AMedievalPerson::BecomeMilitia()
{
    PersonType =
        EMedievalPersonType::Militia;

    UpdateEquipmentVisibility();
}


// =============================================================
// WEAPON
// =============================================================

void AMedievalPerson::EquipWeapon(
    EMilitiaWeapon NewWeapon
)
{
    WeaponType = NewWeapon;

    UpdateEquipmentVisibility();
}


// =============================================================
// SHIELD
// =============================================================

void AMedievalPerson::EquipShield()
{
    HasShield = true;

    UpdateEquipmentVisibility();
}


// =============================================================
// HELMET
// =============================================================

void AMedievalPerson::EquipHelmet()
{
    HasHelmet = true;

    UpdateEquipmentVisibility();
}


// =============================================================
// MAIL
// =============================================================

void AMedievalPerson::EquipMailArmor()
{
    HasMailArmor = true;

    HasPlateArmor = false;

    UpdateEquipmentVisibility();
}


// =============================================================
// PLATE
// =============================================================

void AMedievalPerson::EquipPlateArmor()
{
    HasPlateArmor = true;

    HasMailArmor = false;

    UpdateEquipmentVisibility();
}


// =============================================================
// EQUIPMENT VISIBILITY
// =============================================================

void AMedievalPerson::UpdateEquipmentVisibility()
{
    const bool IsMilitia =
        PersonType ==
        EMedievalPersonType::Militia;


    Helmet->SetVisibility(
        IsMilitia && HasHelmet
    );

    MailArmor->SetVisibility(
        IsMilitia && HasMailArmor
    );

    PlateArmor->SetVisibility(
        IsMilitia && HasPlateArmor
    );

    Shield->SetVisibility(
        IsMilitia && HasShield
    );

    Weapon->SetVisibility(
        IsMilitia &&
        WeaponType !=
        EMilitiaWeapon::None
    );
}


// =============================================================
// APPEARANCE
// =============================================================

void AMedievalPerson::UpdateAppearance()
{
    FVector Scale(
        BodyScale,
        BodyScale,
        HeightScale
    );

    SetActorScale3D(Scale);

    UpdateEquipmentVisibility();
}
