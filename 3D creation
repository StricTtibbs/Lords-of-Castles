<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Medieval Kingdom</title>

<style>
html,body{
    margin:0;
    width:100%;
    height:100%;
    overflow:hidden;
    background:#000;
    font-family:Georgia,serif;
}

#game{
    position:fixed;
    inset:0;
}

#hud{
    position:fixed;
    top:15px;
    left:15px;
    z-index:10;
    padding:15px;
    color:#ead8a8;
    background:rgba(20,18,13,.85);
    border:1px solid #9b7d46;
}

#controls{
    position:fixed;
    bottom:15px;
    left:15px;
    z-index:10;
    padding:12px;
    color:#ddd;
    background:rgba(0,0,0,.65);
    font-size:14px;
}

#map{
    display:none;
    position:fixed;
    inset:10%;
    z-index:20;
    background:rgba(25,25,20,.95);
    border:2px solid #a88a50;
    color:white;
    padding:30px;
}
</style>
</head>

<body>

<div id="game"></div>

<div id="hud">
    <b>MEDIEVAL KINGDOM</b><br><br>
    Season: <span id="season">Spring</span><br>
    Year: <span id="year">1</span><br>
    Families: 5<br>
    Food: 50<br>
    Carp: 10<br>
    Roast Beef: 10<br>
    Logs: 10<br>
    Uncut Stone: 20<br>
    Spears: 10<br>
    Shields: 10
</div>

<div id="controls">
    WASD — Move Camera<br>
    Q / E — Rotate Camera<br>
    R — Rotate Building<br>
    M — Map
</div>

<div id="map">
    <h1>WORLD MAP</h1>
    <p>3D Kingdom Map</p>
    <button onclick="closeMap()">Close</button>
</div>

<script type="module">

import * as THREE from
"https://cdn.jsdelivr.net/npm/three@0.180.0/build/three.module.js";

import {
    OrbitControls
} from
"https://cdn.jsdelivr.net/npm/three@0.180.0/examples/jsm/controls/OrbitControls.js";


// ============================================================
// SCENE
// ============================================================

const scene = new THREE.Scene();

scene.background =
    new THREE.Color(0x91a6a0);

scene.fog =
    new THREE.Fog(
        0x91a6a0,
        80,
        500
    );


// ============================================================
// CAMERA
// ============================================================

const camera =
    new THREE.PerspectiveCamera(
        60,
        innerWidth / innerHeight,
        0.1,
        2000
    );

camera.position.set(
    25,
    25,
    35
);


// ============================================================
// RENDERER
// ============================================================

const renderer =
    new THREE.WebGLRenderer({
        antialias:true
    });

renderer.setSize(
    innerWidth,
    innerHeight
);

renderer.setPixelRatio(
    Math.min(
        devicePixelRatio,
        2
    )
);

renderer.shadowMap.enabled = true;

renderer.shadowMap.type =
    THREE.PCFSoftShadowMap;

document
    .getElementById("game")
    .appendChild(renderer.domElement);


// ============================================================
// LIGHTING
// ============================================================

const sun =
    new THREE.DirectionalLight(
        0xfff1cf,
        3
    );

sun.position.set(
    100,
    150,
    80
);

sun.castShadow = true;

sun.shadow.mapSize.width = 2048;
sun.shadow.mapSize.height = 2048;

scene.add(sun);


const ambient =
    new THREE.HemisphereLight(
        0xc9d8e0,
        0x38432d,
        1.5
    );

scene.add(ambient);


// ============================================================
// TERRAIN
// ============================================================

const terrainSize = 500;

const terrainGeometry =
    new THREE.PlaneGeometry(
        terrainSize,
        terrainSize,
        120,
        120
    );

const positions =
    terrainGeometry.attributes.position;

for(
    let i=0;
    i<positions.count;
    i++
){

    const x =
        positions.getX(i);

    const y =
        positions.getY(i);

    const height =
        Math.sin(x * .035) * 5 +
        Math.cos(y * .025) * 4 +
        Math.sin(
            (x+y)*.018
        ) * 7;

    positions.setZ(
        i,
        height
    );
}

terrainGeometry.computeVertexNormals();


const terrainMaterial =
    new THREE.MeshStandardMaterial({
        color:0x55733d,
        roughness:1
    });


const terrain =
    new THREE.Mesh(
        terrainGeometry,
        terrainMaterial
    );

terrain.rotation.x =
    -Math.PI / 2;

terrain.receiveShadow = true;

scene.add(terrain);


// ============================================================
// TREES
// ============================================================

const trees = [];


function createTree(x,z){

    const tree =
        new THREE.Group();


    const trunk =
        new THREE.Mesh(
            new THREE.CylinderGeometry(
                .35,
                .55,
                5,
                10
            ),
            new THREE.MeshStandardMaterial({
                color:0x604027
            })
        );

    trunk.position.y = 2.5;

    trunk.castShadow = true;

    tree.add(trunk);


    const leaves =
        new THREE.Mesh(
            new THREE.IcosahedronGeometry(
                3.2,
                2
            ),
            new THREE.MeshStandardMaterial({
                color:0x315c2b,
                roughness:1
            })
        );

    leaves.position.y = 6;

    leaves.castShadow = true;

    tree.add(leaves);


    tree.position.set(
        x,
        0,
        z
    );

    scene.add(tree);

    trees.push({
        object:tree,
        leaves:leaves,
        phase:Math.random()*10
    });
}


for(
    let i=0;
    i<180;
    i++
){

    const x =
        (Math.random()-.5)
        * 450;

    const z =
        (Math.random()-.5)
        * 450;

    if(
        Math.abs(x)<50 &&
        Math.abs(z)<50
    )
        continue;

    createTree(x,z);
}


// ============================================================
// BUSHES
// ============================================================

const bushes=[];


function createBush(x,z){

    const bush =
        new THREE.Group();


    for(
        let i=0;
        i<8;
        i++
    ){

        const leaf =
            new THREE.Mesh(
                new THREE.SphereGeometry(
                    .7 +
                    Math.random()*.6,
                    8,
                    8
                ),
                new THREE.MeshStandardMaterial({
                    color:0x416d31
                })
            );

        leaf.position.set(
            (Math.random()-.5)*2,
            .6+Math.random()*1.2,
            (Math.random()-.5)*2
        );

        leaf.scale.y=.8;

        leaf.castShadow=true;

        bush.add(leaf);
    }

    bush.position.set(
        x,
        0,
        z
    );

    scene.add(bush);

    bushes.push({
        object:bush,
        phase:Math.random()*10
    });
}


for(
    let i=0;
    i<250;
    i++
){

    createBush(
        (Math.random()-.5)*450,
        (Math.random()-.5)*450
    );
}


// ============================================================
// TENTS
// ============================================================

function createTent(x,z){

    const tent =
        new THREE.Group();


    const cloth =
        new THREE.Mesh(
            new THREE.ConeGeometry(
                2.5,
                4,
                4
            ),
            new THREE.MeshStandardMaterial({
                color:0xb99b68
            })
        );

    cloth.position.y=2;

    cloth.rotation.y=
        Math.PI/4;

    cloth.castShadow=true;

    tent.add(cloth);


    tent.position.set(
        x,
        0,
        z
    );

    scene.add(tent);
}


for(
    let i=0;
    i<5;
    i++
){

    createTent(
        -12+i*6,
        5
    );
}


// ============================================================
// VILLAGERS
// ============================================================

const villagers=[];


function createVillager(x,z){

    const person =
        new THREE.Group();


    const body =
        new THREE.Mesh(
            new THREE.CapsuleGeometry(
                .35,
                1.1,
                5,
                10
            ),
            new THREE.MeshStandardMaterial({
                color:0x66503c
            })
        );

    body.position.y=1;

    body.castShadow=true;

    person.add(body);


    const head =
        new THREE.Mesh(
            new THREE.SphereGeometry(
                .32,
                12,
                12
            ),
            new THREE.MeshStandardMaterial({
                color:0xc89167
            })
        );

    head.position.y=1.85;

    head.castShadow=true;

    person.add(head);


    person.position.set(
        x,
        0,
        z
    );

    scene.add(person);

    villagers.push({
        object:person,
        target:new THREE.Vector3(
            (Math.random()-.5)*40,
            0,
            (Math.random()-.5)*40
        )
    });
}


for(
    let i=0;
    i<20;
    i++
){

    createVillager(
        (Math.random()-.5)*20,
        (Math.random()-.5)*20
    );
}


// ============================================================
// CAMERA CONTROLS
// ============================================================

const keys={};

window.addEventListener(
    "keydown",
    e=>{
        keys[e.key.toLowerCase()]=true;

        if(
            e.key.toLowerCase()==="m"
        ){
            document
                .getElementById("map")
                .style.display="block";
        }
    }
);


window.addEventListener(
    "keyup",
    e=>{
        keys[e.key.toLowerCase()]=false;
    }
);


function closeMap(){

    document
        .getElementById("map")
        .style.display="none";
}

window.closeMap=closeMap;


// ============================================================
// SEASONS
// ============================================================

const seasons=[
    "Spring",
    "Summer",
    "Autumn",
    "Winter"
];

let seasonIndex=0;

let year=1;

let seasonTimer=0;

function updateSeason(delta){

    seasonTimer+=delta;

    if(
        seasonTimer>30
    ){

        seasonTimer=0;

        seasonIndex++;

        if(
            seasonIndex>=4
        ){

            seasonIndex=0;

            year++;
        }

        document
            .getElementById("season")
            .textContent=
                seasons[seasonIndex];

        document
            .getElementById("year")
            .textContent=
                year;


        const colours=[
            0x72a84d,
            0x638b3d,
            0xb4773d,
            0xdde5e8
        ];

        terrainMaterial.color.setHex(
            colours[seasonIndex]
        );
    }
}


// ============================================================
// WIND
// ============================================================

const clock =
    new THREE.Clock();


function animate(){

    requestAnimationFrame(
        animate
    );

    const delta =
        clock.getDelta();

    const time =
        clock.elapsedTime;


    // --------------------------------------------
    // CAMERA
    // --------------------------------------------

    const speed =
        20 * delta;


    if(keys["w"])
        camera.translateZ(-speed);

    if(keys["s"])
        camera.translateZ(speed);

    if(keys["a"])
        camera.translateX(-speed);

    if(keys["d"])
        camera.translateX(speed);


    if(keys["q"])
        camera.rotation.y +=
            1.5 * delta;

    if(keys["e"])
        camera.rotation.y -=
            1.5 * delta;


    // --------------------------------------------
    // TREES SWAYING
    // --------------------------------------------

    trees.forEach(
        tree=>{

            const sway =
                Math.sin(
                    time*1.2+
                    tree.phase
                )*.035;

            tree.leaves.rotation.z=
                sway;

            tree.leaves.rotation.x=
                Math.sin(
                    time*.8+
                    tree.phase
                )*.025;
        }
    );


    // --------------------------------------------
    // BUSHES MOVING
    // --------------------------------------------

    bushes.forEach(
        bush=>{

            const sway=
                Math.sin(
                    time*1.8+
                    bush.phase
                )*.035;

            bush.object.rotation.z=
                sway;
        }
    );


    // --------------------------------------------
    // VILLAGERS
    // --------------------------------------------

    villagers.forEach(
        villager=>{

            const position=
                villager.object.position;

            const target=
                villager.target;

            const direction=
                new THREE.Vector3()
                .subVectors(
                    target,
                    position
                );

            if(
                direction.length()>1
            ){

                direction.normalize();

                position.add(
                    direction
                    .multiplyScalar(
                        delta*1.5
                    )
                );

                villager.object.rotation.y=
                    Math.atan2(
                        direction.x,
                        direction.z
                    );
            }
            else{

                villager.target.set(
                    (Math.random()-.5)*40,
                    0,
                    (Math.random()-.5)*40
                );
            }
        }
    );


    // --------------------------------------------
    // SEASONS
    // --------------------------------------------

    updateSeason(delta);


    renderer.render(
        scene,
        camera
    );
}


animate();


// ============================================================
// RESIZE
// ============================================================

window.addEventListener(
    "resize",
    ()=>{

        camera.aspect=
            innerWidth /
            innerHeight;

        camera.updateProjectionMatrix();

        renderer.setSize(
            innerWidth,
            innerHeight
        );
    }
);

</script>

</body>
</html>
