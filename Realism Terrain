void ATerrainWorld::UpdateWater()
{
    /*
        Water surface animation:

        - ripples
        - reflections
        - river movement
        - wind interaction
    */
float WindWave =
    sin(
        WorldPosition.X * 0.015f +
        WorldPosition.Y * 0.01f +
        Time * WindSpeed
    );

float Gust =
    sin(
        Time * 0.35f +
        WorldPosition.X * 0.002f
    );

float FinalWind =
    WindWave *
    WindStrength;

FinalWind +=
    Gust *
