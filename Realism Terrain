/* ============================================================
   TERRAIN HEIGHT
   ============================================================ */

float ATerrainWorld::GetTerrainHeight(
    float X,
    float Y
)
{
    float LargeShape =
        MountainNoise(
            X * 0.00035f,
            Y * 0.00035f
        );

    float Valley =
        ValleyNoise(
            X * 0.0008f,
            Y * 0.0008f
        );

    float Detail =
        DetailNoise(
            X * 0.003f,
            Y * 0.003f
        );

    float SmallDetail =
        DetailNoise(
            X * 0.015f,
            Y * 0.015f
        );

    float Height =
        LargeShape * 650.0f;

    Height += Valley * 230.0f;

    Height += Detail * 65.0f;

    Height += SmallDetail * 12.0f;

    return Height;
}


/* ============================================================
   MOUNTAINS
   ============================================================ */

float ATerrainWorld::MountainNoise(
    float X,
    float Y
)
{
    float A =
        FMath::PerlinNoise2D(
            FVector2D(X, Y)
        );

    float B =
        FMath::PerlinNoise2D(
            FVector2D(
                X * 2.0f,
                Y * 2.0f
            )
        ) * 0.5f;

    float C =
        FMath::PerlinNoise2D(
            FVector2D(
                X * 4.0f,
                Y * 4.0f
            )
        ) * 0.25f;

    float D =
        FMath::PerlinNoise2D(
            FVector2D(
                X * 8.0f,
                Y * 8.0f
            )
        ) * 0.125f;

    return
        A +
        B +
        C +
        D;
}


/* ============================================================
   VALLEYS
   ============================================================ */

float ATerrainWorld::ValleyNoise(
    float X,
    float Y
)
{
    float N =
        FMath::PerlinNoise2D(
            FVector2D(
                X,
                Y
            )
        );

    N = FMath::Abs(N);

    return -N;
}


/* ============================================================
   SMALL TERRAIN DETAIL
   ============================================================ */

float ATerrainWorld::DetailNoise(
    float X,
    float Y
)
{
    return FMath::PerlinNoise2D(
        FVector2D(X, Y)
    );
}


/* ============================================================
   GRASS
   ============================================================ */

void ATerrainWorld::GenerateGrass()
{
    /*
        In the actual renderer, grass should be rendered using
        GPU-instanced meshes rather than individual Actors.

        Millions of blades can therefore be displayed efficiently.
    */

    const int32 GridSize = 512;

    for (int32 X = 0; X < GridSize; X++)
    {
        for (int32 Y = 0; Y < GridSize; Y++)
        {
            float WorldX =
                (X / (float)GridSize)
                * WorldSize
                - WorldSize / 2;

            float WorldY =
                (Y / (float)GridSize)
                * WorldSize
                - WorldSize / 2;

            float Height =
                GetTerrainHeight(
                    WorldX,
                    WorldY
                );

            /*
                Grass density varies naturally.
            */

            float DensityNoise =
                FMath::PerlinNoise2D(
                    FVector2D(
                        WorldX * 0.02f,
                        WorldY * 0.02f
                    )
                );

            if (DensityNoise > -0.2f)
            {
                // GPU grass instances go here.
            }
        }
    }
}


/* ============================================================
   TREES
   ============================================================ */

void ATerrainWorld::GenerateTrees()
{
    const int32 TreeGrid = 100;

    for (int32 X = 0; X < TreeGrid; X++)
    {
        for (int32 Y = 0; Y < TreeGrid; Y++)
        {
            float WorldX =
                X * (WorldSize / (float)TreeGrid)
                - WorldSize / 2;

            float WorldY =
                Y * (WorldSize / (float)TreeGrid)
                - WorldSize / 2;

            float Height =
                GetTerrainHeight(
                    WorldX,
                    WorldY
                );

            float Noise =
                FMath::PerlinNoise2D(
                    FVector2D(
                        WorldX * 0.004f,
                        WorldY * 0.004f
                    )
                );

            if (Noise > 0.15f)
            {
                /*
                    Spawn tree instance.

                    Tree material receives:

                    WindTime
                    WindStrength
                    WindDirection
                    Turbulence
                */
            }
        }
    }
}


