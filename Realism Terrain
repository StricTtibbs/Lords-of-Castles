/* ============================================================
   WIND
   ============================================================ */

void ATerrainWorld::UpdateWind(
    float DeltaTime
)
{
    /*
        Slowly change wind direction.
    */

    float DirectionChange =
        FMath::Sin(
            WindTime * 0.08f
        );

    float DirectionChange2 =
        FMath::Sin(
            WindTime * 0.17f
        );

    FVector Direction(
        1.0f,
        DirectionChange * 0.45f,
        0.0f
    );

    Direction.Normalize();

    Wind.Direction = Direction;


    /*
        Base wind.
    */

    Wind.Strength =
        0.25f +
        (
            FMath::Sin(
                WindTime * 0.4f
            ) + 1.0f
        ) * 0.18f;


    /*
        Random gusts.
    */

    float GustWave =
        FMath::PerlinNoise1D(
            WindTime * 0.12f
        );

    Wind.GustStrength =
        FMath::Max(
            0.0f,
            GustWave
        );


    /*
        Fine turbulence.
    */

    Wind.Turbulence =
        FMath::PerlinNoise1D(
            WindTime * 0.8f
        );
}


/* ============================================================
   VEGETATION WIND
   ============================================================ */

void ATerrainWorld::UpdateVegetationWind()
{
    /*
        Send these values to the vegetation material.

        Grass:
            strong movement

        Bushes:
            medium movement

        Tree branches:
            slower movement

        Tree trunks:
            very small movement
    */

    float GrassWind =
        Wind.Strength +
        Wind.GustStrength * 0.8f;

    float TreeWind =
        Wind.Strength * 0.45f +
        Wind.GustStrength * 0.35f;

    float BranchTurbulence =
        Wind.Turbulence * 0.25f;


