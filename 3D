// ============================================================
// UTILITIES
// ============================================================

int32 AMedieval3DWorld::GetTileIndex(
    int32 X,
    int32 Y
) const
{
    return
        Y * WorldSize + X;
}


bool AMedieval3DWorld::IsInsideWorld(
    int32 X,
    int32 Y
) const
{
    return
        X >= 0 &&
        Y >= 0 &&
        X < WorldSize &&
        Y < WorldSize;
}


FVector AMedieval3DWorld::GetWorldLocation(
    int32 X,
    int32 Y
) const
{
    if (
        !IsInsideWorld(
            X,
            Y
        )
    )
    {
        return FVector::ZeroVector;
    }

    return
        Tiles[
            GetTileIndex(
                X,
                Y
            )
        ].Location;
}
