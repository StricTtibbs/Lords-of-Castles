// ============================================================
// STARTING TENTS
// ============================================================

void AMedieval3DWorld::SpawnStartingTents()
{
    FVector Centre =
        GetWorldLocation(
            WorldSize / 2,
            WorldSize / 2
        );

    /*
     * Five starting family tents.
     *
     * Each family can later contain:
     *
     * Parents
     * Children
     * Workers
     * Farmers
     * Builders
     * Militia
     */

    for (
        int32 Family = 0;
        Family < 5;
        Family++
    )
    {
        float Angle =
            Family *
            72.0f;

        FVector Offset =
            FVector(
                FMath::Cos(
                    FMath::DegreesToRadians(
                        Angle
                    )
                ),
                FMath::Sin(
                    FMath::DegreesToRadians(
                        Angle
                    )
                ),
                0
            ) * 1000.0f;

        FVector TentLocation =
            Centre +
            Offset;

        /*
         * Spawn detailed tent here.
         */
    }
}


