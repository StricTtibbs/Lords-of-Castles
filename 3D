UENUM(BlueprintType)
enum class EWorldMapType : uint8
{
    GreenValley,
    HighlandKingdom,
    Riverlands,
    DeepForest,
    CoastalPlains
};

UENUM(BlueprintType)
enum class EResourceType : uint8
{
    None,
    Wood,
    Stone,
    Iron,
    Copper,
    Tin,
    Gold,
    Salt,
    Clay,
    Flax,
    FertileSoil,
    Fish
};

USTRUCT(BlueprintType)
struct FWorldTile
{
    GENERATED_BODY()

    FVector Location = FVector::ZeroVector;

    float Height = 0.0f;
    float Moisture = 0.0f;
    float Fertility = 0.0f;
    float Temperature = 0.0f;
    float Slope = 0.0f;

    bool bWater = false;
    bool bRiver = false;
    bool bForest = false;
    bool bRoad = false;

    EResourceType Resource =
        EResourceType::None;
};

UCLASS()
class MEDIEVALGAME_API AMedieval3DWorld
