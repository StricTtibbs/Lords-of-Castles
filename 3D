    UPROPERTY()
    UProceduralMeshComponent* TerrainMesh;

    UPROPERTY()
    UProceduralMeshComponent* WaterMesh;

    // ========================================================
    // GENERATION
    // ========================================================

    void GenerateWorld();

    void GenerateTerrain();

    void GenerateWater();

    void GenerateRivers();

    void GenerateForests();

    void GenerateResources();

    void GenerateRoads();

    void GenerateStartingSettlement();

    // ========================================================
    // TERRAIN FUNCTIONS
    // ========================================================

    float GetHeight(
        float X,
        float Y
    ) const;

    float GetMountainHeight(
        float X,
        float Y
    ) const;

    float GetValleyHeight(
        float X,
        float Y
    ) const;

    float GetRiverHeight(
        float X,
        float Y
    ) const;

    float GetMoisture(
        float X,
        float Y
    ) const;

    float GetFertility(
        float X,
        float Y
    ) const;

    float GetTemperature(
        float X,
        float Y
    ) const;

    // ========================================================
    // 3D OBJECTS
    // ========================================================

    void SpawnTrees();

    void SpawnRocks();

    void SpawnBushes();

    void SpawnGrass();

    void SpawnResourceNodes();

    // ========================================================
    // SETTLEMENT
    // ========================================================

    void SpawnStartingHouses();

    void SpawnStartingTents();

    void SpawnStartingRoads();

    // ========================================================
    // UTILITIES
    // ========================================================

    int32 GetTileIndex(
        int32 X,
        int32 Y
    ) const;

    bool IsInsideWorld(
        int32 X,
        int32 Y
    ) const;

    FVector GetWorldLocation(
        int32 X,
        int32 Y
    ) const;

    // ========================================================
    // WIND
    // ========================================================

