{
    GENERATED_BODY()

    UPROPERTY(BlueprintReadWrite)
    int32 Carp = 10;

    UPROPERTY(BlueprintReadWrite)
    int32 RoastBeef = 10;

    UPROPERTY(BlueprintReadWrite)
