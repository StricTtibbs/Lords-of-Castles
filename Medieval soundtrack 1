<audio id="medievalMusic" loop preload="auto">
    <source src="/medieval-soundtrack.mp3" type="audio/mpeg">
</audio>

<script>
const medievalMusic = document.getElementById("medievalMusic");

medievalMusic.volume = 0.35;

// Start music after the player's first interaction
document.addEventListener("click", function startMusic() {
    medievalMusic.play().catch(() => {});
    document.removeEventListener("click", startMusic);
}, { once: true });

// Volume control
function setMusicVolume(volume) {
    medievalMusic.volume = Math.max(0, Math.min(1, volume));
}

// Mute / unmute
function toggleMusic() {
    medievalMusic.muted = !medievalMusic.muted;
}
</script>
<label for="musicVolume">Music Volume</label>

<input
    id="musicVolume"
    type="range"
    min="0"
    max="1"
    step="0.01"
    value="0.35"
    oninput="setMusicVolume(this.value)"
>
medieval-soundtrack.mp3
