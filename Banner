<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Lords of Castles - New Game</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html,
body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
}

body {
    font-family: Arial, Helvetica, sans-serif;
}


/* =====================================================
   NEW GAME SCREEN
===================================================== */

.new-game-screen {

    position: relative;

    width: 100vw;
    height: 100vh;

    background-image:
        url("Screenshot 2026-09-28 at 9.04.51 PM.png");

    background-size: cover;

    background-position: center;

    background-repeat: no-repeat;

}


/* =====================================================
   INVISIBLE INTERACTION AREAS
===================================================== */

.click-area {

    position: absolute;

    background: transparent;

    border: none;

    cursor: pointer;

    padding: 0;

}


/* Back / New Game title */

.back-button {

    left: 0;

    top: 0;

    width: 30%;

    height: 12%;

}


/* Coat of Arms */

.coat-of-arms {

    left: 38%;

    top: 10%;

    width: 58%;

    height: 23%;

}


/* Background section */

.background-selector {

    left: 28%;

    top: 35%;

    width: 31%;

    height: 60%;

}


/* Symbol section */

.symbol-selector {

    left: 60%;

    top: 35%;

    width: 35%;

    height: 60%;

}


/* Shield */

.shield-preview {

    left: 3%;

    top: 17%;

    width: 25%;

    height: 34%;

}


/* =====================================================
   OPTIONAL MESSAGE
===================================================== */

.message {

    position: absolute;

    left: 50%;

    bottom: 20px;

    transform: translateX(-50%);

    padding: 10px 20px;

    background: rgba(0,0,0,0.75);

    border: 1px solid #777;

    color: white;

    font-size: 14px;

    opacity: 0;

    pointer-events: none;

    transition: opacity 0.2s;

}

.message.show {

    opacity: 1;

}

</style>

</head>


<body>


<div class="new-game-screen">


    <!-- =================================================
         NEW GAME / BACK
    ================================================= -->

    <button
        class="click-area back-button"
        onclick="goBack()"
        aria-label="Back">
    </button>


    <!-- =================================================
         COAT OF ARMS
    ================================================= -->

    <button
        class="click-area coat-of-arms"
        onclick="selectCoatOfArms()"
        aria-label="Coat of Arms">
    </button>


    <!-- =================================================
         BACKGROUND
    ================================================= -->

    <button
        class="click-area background-selector"
        onclick="selectBackground()"
        aria-label="Background">
    </button>


    <!-- =================================================
         SYMBOL
    ================================================= -->

    <button
        class="click-area symbol-selector"
        onclick="selectSymbol()"
        aria-label="Symbol">
    </button>


    <!-- =================================================
         SHIELD PREVIEW
    ================================================= -->

    <button
        class="click-area shield-preview"
        onclick="selectShield()"
        aria-label="Shield Preview">
    </button>


    <!-- MESSAGE -->

    <div
        id="message"
        class="message">
    </div>

</div>


<script>


/* =====================================================
   BACK
===================================================== */

function goBack() {

    window.history.back();

}


/* =====================================================
   COAT OF ARMS
===================================================== */

function selectCoatOfArms() {

    showMessage(
        "Coat of Arms selected"
    );

}


/* =====================================================
   BACKGROUND
===================================================== */

function selectBackground() {

    showMessage(
        "Background selection"
    );

}


/* =====================================================
   SYMBOL
===================================================== */

function selectSymbol() {

    showMessage(
        "Symbol selection"
    );

}


/* =====================================================
   SHIELD
===================================================== */

function selectShield() {

    showMessage(
        "Shield preview selected"
    );

}


/* =====================================================
   MESSAGE
===================================================== */

function showMessage(text) {

    const message =
        document.getElementById("message");

    message.textContent = text;

    message.classList.add("show");


    setTimeout(function() {

        message.classList.remove("show");

    }, 1200);

}

</script>


</body>
</html>
