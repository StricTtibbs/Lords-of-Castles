#include "MedievalTerrain.h"

#include "ProceduralMeshComponent.h"
#include "Kismet/KismetMathLibrary.h"

AMedievalTerrain::AMedievalTerrain()
{
    PrimaryActorTick.bCanEverTick = false;

    RootComponent =
        CreateDefaultSubobject<USceneComponent>(
            TEXT("TerrainRoot")
        );
}

void AMedievalTerrain::BeginPlay()
{
    Super::BeginPlay();

    GenerateTerrain();
}

float AMedievalTerrain::GetTerrainHeight(
    float X,
    float Y
) const
{
    // Large hills
    float LargeHills =
        FMath::PerlinNoise2D(
            FVector2D(
                X * NoiseScale,
                Y * NoiseScale
            )
        );

    // Smaller terrain variation
    float SmallDetail =
        FMath::PerlinNoise2D(
            FVector2D(
                X * NoiseScale * 4.0f,
                Y * NoiseScale * 4.0f
            )
        );

    // Very small surface detail
    float FineDetail =
        FMath::PerlinNoise2D(
            FVector2D(
                X * NoiseScale * 12.0f,
                Y * NoiseScale * 12.0f
            )
        );

    float Height =
        LargeHills * MaximumHeight;

    Height +=
        SmallDetail *
        MaximumHeight *
        0.25f;

    Height +=
        FineDetail *
        MaximumHeight *
        0.05f;

    return Height * MountainStrength;
}

void AMedievalTerrain::GenerateTerrain()
{
    UProceduralMeshComponent* TerrainMesh =
        NewObject<UProceduralMeshComponent>(
            this,
            TEXT("TerrainMesh")
        );

    TerrainMesh->RegisterComponent();

    TerrainMesh->AttachToComponent(
        RootComponent,
        FAttachmentTransformRules::KeepRelativeTransform
    );

    TArray<FVector> Vertices;
    TArray<int32> Triangles;
    TArray<FVector> Normals;
    TArray<FVector2D> UVs;
    TArray<FLinearColor> Colors;
    TArray<FProcMeshTangent> Tangents;

    const int32 VertexCountX = SizeX + 1;
    const int32 VertexCountY = SizeY + 1;

    Vertices.Reserve(
        VertexCountX *
        VertexCountY
    );

    UVs.Reserve(
        VertexCountX *
        VertexCountY
    );

    // =========================================================
    // CREATE TERRAIN VERTICES
    // =========================================================

    for (int32 Y = 0; Y < VertexCountY; Y++)
    {
        for (int32 X = 0; X < VertexCountX; X++)
        {
            float WorldX =
                X * CellSize;

            float WorldY =
                Y * CellSize;

            float Height =
                GetTerrainHeight(
                    WorldX,
                    WorldY
                );

            Vertices.Add(
                FVector(
                    WorldX,
                    WorldY,
                    Height
                )
            );

            UVs.Add(
                FVector2D(
                    static_cast<float>(X) /
                    SizeX,

                    static_cast<float>(Y) /
                    SizeY
                )
            );
        }
    }

    // =========================================================
    // CREATE TRIANGLES
    // =========================================================

    for (int32 Y = 0; Y < SizeY; Y++)
    {
        for (int32 X = 0; X < SizeX; X++)
        {
            int32 A =
                Y * VertexCountX + X;

            int32 B =
                A + 1;

            int32 C =
                A + VertexCountX;

            int32 D =
                C + 1;

            Triangles.Add(A);
            Triangles.Add(C);
            Triangles.Add(B);

            Triangles.Add(B);
            Triangles.Add(C);
            Triangles.Add(D);
        }
    }

    // =========================================================
    // CREATE MESH
    // =========================================================

    TerrainMesh->CreateMeshSection_LinearColor(
        0,
        Vertices,
        Triangles,
        Normals,
        UVs,
        Colors,
        Tangents,
        true
    );

    TerrainMesh->bUseComplexAsSimpleCollision = true;

    TerrainMesh->SetCollisionEnabled(
        ECollisionEnabled::QueryAndPhysics
    );
}

This produces a genuine 3D landscape with multiple layers of procedural height variation.

