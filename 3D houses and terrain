void AMedievalHouse::BuildHouse()
{
    const float HalfWidth =
        HouseWidth * 0.5f;

    const float HalfLength =
        HouseLength * 0.5f;


    // =========================================================
    // FRONT WALL
    // =========================================================

    CreateWall(
        FVector(
            0,
            -HalfLength,
            WallHeight * 0.5f
        ),

        FVector(
            HouseWidth / 100.0f,
            WallThickness / 100.0f,
            WallHeight / 100.0f
        )
    );


    // =========================================================
    // BACK WALL
    // =========================================================

    CreateWall(
        FVector(
            0,
            HalfLength,
            WallHeight * 0.5f
        ),

        FVector(
            HouseWidth / 100.0f,
            WallThickness / 100.0f,
            WallHeight / 100.0f
        )
    );


    // =========================================================
    // LEFT WALL
    // =========================================================

    CreateWall(
        FVector(
            -HalfWidth,
            0,
            WallHeight * 0.5f
        ),

        FVector(
            WallThickness / 100.0f,
            HouseLength / 100.0f,
            WallHeight / 100.0f
        )
    );


    // =========================================================
    // RIGHT WALL
    // =========================================================

    CreateWall(
        FVector(
            HalfWidth,
            0,
            WallHeight * 0.5f
        ),

        FVector(
            WallThickness / 100.0f,
            HouseLength / 100.0f,
            WallHeight / 100.0f
        )
    );


    // =========================================================
    // ROOF
    // =========================================================

    CreateRoof(
        FVector(
            0,
            0,
            WallHeight + RoofHeight * 0.5f
        ),

        FVector(
            HouseWidth / 100.0f,
            HouseLength / 100.0f,
            RoofHeight / 100.0f
        )
    );


    // =========================================================
    // DOOR
    // =========================================================

    if (HasDoor)
    {
        CreateDoor(
            FVector(
                0,
                -HalfLength - 20,
                130
            )
        );
    }


    // =========================================================
    // WINDOWS
    // =========================================================

    if (HasWindows)
    {
        CreateWindow(
            FVector(
                -HouseWidth * 0.25f,
                -HalfLength - 20,
                WallHeight * 0.55f
            )
        );

        CreateWindow(
            FVector(
                HouseWidth * 0.25f,
                -HalfLength - 20,
                WallHeight * 0.55f
            )
        );

        CreateWindow(
            FVector(
                -HalfWidth - 20,
                0,
                WallHeight * 0.55f
            )
        );

        CreateWindow(
            FVector(
                HalfWidth + 20,
                0,
                WallHeight * 0.55f
            )
        );
    }


    // =========================================================
    // CHIMNEY
    // =========================================================

    if (HasChimney)
    {
        CreateChimney(
            FVector(
                HouseWidth * 0.25f,
                0,
                WallHeight +
                RoofHeight
            )
        );
    }
}
