#include "MedievalWorldGenerator.h"

AMedievalWorldGenerator::AMedievalWorldGenerator()
{
    PrimaryActorTick.bCanEverTick = false;

    Settings.Width = 2048;
    Settings.Height = 2048;
    Settings.CellSize = 100.0f;

    Settings.MountainStrength = 1.0f;
    Settings.ValleyStrength = 1.0f;
    Settings.ForestStrength = 1.0f;
    Settings.RiverStrength = 1.0f;
    Settings.ResourceStrength = 1.0f;
}


void AMedievalWorldGenerator::BeginPlay()
{
    Super::BeginPlay();

    GenerateMap(
        EMedievalMapType::GreenValley,
        Settings.Seed
    );
}


// ============================================================
// INDEX
// ============================================================

int32 AMedievalWorldGenerator::Index(
    int32 X,
    int32 Y
) const
{
    return Y * Settings.Width + X;
}


// ============================================================
// MAP GENERATION
// ============================================================

void AMedievalWorldGenerator::GenerateMap(
    EMedievalMapType MapType,
    int32 Seed
)
{
    CurrentMap = MapType;

    Settings.Seed = Seed;

    Random.Initialize(Seed);

    Terrain.Empty();

    Terrain.SetNum(
        Settings.Width *
        Settings.Height
    );

    for (
        int32 Y = 0;
        Y < Settings.Height;
        ++Y
    )
    {
        for (
            int32 X = 0;
            X < Settings.Width;
            ++X
        )
        {
            FTerrainCell& Cell =
                Terrain[Index(X, Y)];

            float WorldX =
                X * Settings.CellSize;

            float WorldY =
                Y * Settings.CellSize;

            Cell.WorldPosition =
                FVector(
                    WorldX,
                    WorldY,
                    0.0f
                );

            float Height =
                GenerateBaseHeight(
                    X,
                    Y
                );

            Cell.Height =
                FMath::Clamp(
                    Height,
                    0.0f,
                    1.0f
                );

            Cell.Moisture =
                GenerateMoisture(
                    X,
                    Y
                );

            Cell.Temperature =
                GenerateTemperature(
                    X,
                    Y
                );

            Cell.Fertility =
                GenerateFertility(
                    X,
                    Y,
                    Cell.Moisture,
                    Cell.Temperature
                );

            Cell.Material =
                DetermineTerrainMaterial(
                    Cell
                );
        }
    }

    GenerateRivers();

    GenerateForests();

    GenerateResources();

    FindSettlementLocations();
}


// ============================================================
// BASE HEIGHT
// ============================================================

float AMedievalWorldGenerator::GenerateBaseHeight(
    float X,
    float Y
) const
{
    float Base =
        Noise(
            X,
            Y,
            0.0025f,
            6
        );

    float LargeScale =
        Noise(
            X,
            Y,
            0.0006f,
            4
        );

    float Mountains =
        RidgedNoise(
            X,
            Y,
            0.0015f,
            5
        );

    float Height =
        Base * 0.45f +
        LargeScale * 0.25f +
        Mountains * 0.30f;

    switch (CurrentMap)
    {
        case EMedievalMapType::GreenValley:

            Height -=
                GenerateValleyHeight(
                    X,
                    Y
                );

            break;


        case EMedievalMapType::HighlandKingdom:

            Height +=
                GenerateMountainHeight(
                    X,
                    Y
                );

            break;


        case EMedievalMapType::Riverlands:

            Height -=
                GenerateRiverInfluence(
                    X,
                    Y
                );

            break;


        case EMedievalMapType::DeepForest:

            Height +=
                Noise(
                    X,
                    Y,
                    0.0012f,
                    5
                ) * 0.15f;

            break;


        case EMedievalMapType::CoastalPlains:

            Height +=
                GenerateCoastInfluence(
                    X,
                    Y
                );

            break;
    }

    return Height;
}


// ============================================================
// MOUNTAINS
// ============================================================

float AMedievalWorldGenerator::GenerateMountainHeight(
    float X,
    float Y
) const
{
    float Mountains =
        RidgedNoise(
            X,
            Y,
            0.0011f,
            7
        );

    Mountains =
        FMath::Pow(
            Mountains,
            1.8f
        );

    return Mountains *
        Settings.MountainStrength *
        0.55f;
}


// ============================================================
// VALLEYS
// ============================================================

float AMedievalWorldGenerator::GenerateValleyHeight(
    float X,
    float Y
) const
{
    float Valley =
        Noise(
            X,
            Y,
            0.0010f,
            4
        );

    Valley =
        1.0f -
        FMath::Abs(
            Valley * 2.0f - 1.0f
        );

    return Valley *
        Settings.ValleyStrength *
        0.35f;
}


// ============================================================
// RIVER INFLUENCE
// ============================================================

float AMedievalWorldGenerator::GenerateRiverInfluence(
    float X,
    float Y
) const
{
    float RiverNoise =
        FMath::Abs(
            Noise(
                X,
                Y,
                0.0017f,
                5
            ) - 0.5f
        );

    float River =
        1.0f -
        FMath::Clamp(
            RiverNoise * 8.0f,
            0.0f,
            1.0f
        );

    return River *
        Settings.RiverStrength *
        0.30f;
}


// ============================================================
// COAST
// ============================================================

float AMedievalWorldGenerator::GenerateCoastInfluence(
    float X,
    float Y
) const
{
    float NormalizedX =
        X /
        static_cast<float>(
            Settings.Width
        );

    return
        (1.0f - NormalizedX)
        * 0.65f;
}


// ============================================================
// MOISTURE
// ============================================================

float AMedievalWorldGenerator::GenerateMoisture(
    float X,
    float Y
) const
{
    return FMath::Clamp(
        Noise(
            X,
            Y,
            0.0018f,
            5
        ),
        0.0f,
        1.0f
    );
}


// ============================================================
// TEMPERATURE
// ============================================================

float AMedievalWorldGenerator::GenerateTemperature(
    float X,
    float Y
) const
{
    float Latitude =
        Y /
        static_cast<float>(
            Settings.Height
        );

    float Temperature =
        1.0f -
        FMath::Abs(
            Latitude - 0.5f
        ) * 1.5f;

    return FMath::Clamp(
        Temperature,
        0.0f,
        1.0f
    );
}


// ============================================================
// FERTILITY
// ============================================================

float AMedievalWorldGenerator::GenerateFertility(
    float X,
    float Y,
    float Moisture,
    float Temperature
) const
{
    float SoilNoise =
        Noise(
            X,
            Y,
            0.003f,
            4
        );

    float Fertility =
        SoilNoise *
        0.45f +

        Moisture *
        0.35f +

        Temperature *
        0.20f;

    return FMath::Clamp(
        Fertility,
        0.0f,
        1.0f
    );
}


// ============================================================
// TERRAIN MATERIAL
// ============================================================

ETerrainMaterial
AMedievalWorldGenerator::DetermineTerrainMaterial(
    const FTerrainCell& Cell
) const
{
    if (Cell.Height < 0.20f)
        return ETerrainMaterial::DeepWater;

    if (Cell.Height < 0.27f)
        return ETerrainMaterial::ShallowWater;

    if (Cell.Height < 0.31f)
        return ETerrainMaterial::WetSand;

    if (Cell.Height < 0.35f)
        return ETerrainMaterial::Sand;

    if (Cell.Height < 0.60f)
    {
        if (Cell.Fertility > 0.72f)
            return ETerrainMaterial::RichGrass;

        return ETerrainMaterial::Grass;
    }

    if (Cell.Height < 0.76f)
        return ETerrainMaterial::Meadow;

    if (Cell.Height < 0.90f)
        return ETerrainMaterial::RockyGround;

    return ETerrainMaterial::Mountain;
}


// ============================================================
// FORESTS
// ============================================================

void AMedievalWorldGenerator::GenerateForests()
{
    for (
        int32 Y = 0;
        Y < Settings.Height;
        ++Y
    )
    {
        for (
            int32 X = 0;
            X < Settings.Width;
            ++X
        )
        {
            GenerateForestCell(
                Terrain[Index(X, Y)],
                X,
                Y
            );
        }
    }
}


void AMedievalWorldGenerator::GenerateForestCell(
    FTerrainCell& Cell,
    int32 X,
    int32 Y
)
{
    if (
        Cell.Material ==
        ETerrainMaterial::DeepWater
    )
        return;

    if (
        Cell.Material ==
        ETerrainMaterial::ShallowWater
    )
        return;

    float ForestNoise =
        Noise(
            X,
            Y,
            0.004f,
            5
        );

    float Density =
        ForestNoise *
        Cell.Moisture *
        Settings.ForestStrength;

    if (CurrentMap ==
        EMedievalMapType::DeepForest)
    {
        Density *= 1.8f;
    }

    Cell.ForestDensity =
        FMath::Clamp(
            Density,
            0.0f,
            1.0f
        );
}


// ============================================================
// RESOURCES
// ============================================================

void AMedievalWorldGenerator::GenerateResources()
{
    for (
        int32 Y = 0;
        Y < Settings.Height;
        ++Y
    )
    {
        for (
            int32 X = 0;
            X < Settings.Width;
            ++X
        )
        {
            FTerrainCell& Cell =
                Terrain[Index(X, Y)];

            Cell.Resource =
                DetermineResource(
                    Cell,
                    X,
                    Y
                );
        }
    }
}


EMedievalResource
AMedievalWorldGenerator::DetermineResource(
    const FTerrainCell& Cell,
    int32 X,
    int32 Y
) const
{
    float R =
        Noise(
            X,
            Y,
            0.008f,
            3
        );

    if (
        Cell.ForestDensity > 0.65f &&
        R > 0.45f
    )
    {
        return EMedievalResource::Wood;
    }

    if (
        Cell.Material ==
        ETerrainMaterial::RockyGround
        &&
        R > 0.70f
    )
    {
        return EMedievalResource::Stone;
    }

    if (
        Cell.Material ==
        ETerrainMaterial::Mountain
        &&
        R > 0.70f
    )
    {
        return EMedievalResource::Iron;
    }

    if (
        Cell.Fertility > 0.75f
    )
    {
        return EMedievalResource::FertileSoil;
    }

    if (
        Cell.Moisture > 0.75f &&
        Cell.Temperature > 0.45f
    )
    {
        return EMedievalResource::Flax;
    }

    return EMedievalResource::None;
}


// ============================================================
// RIVERS
// ============================================================

void AMedievalWorldGenerator::GenerateRivers()
{
    if (
        CurrentMap ==
        EMedievalMapType::CoastalPlains
    )
    {
        return;
    }

    int32 RiverCount = 8;

    for (
        int32 River = 0;
        River < RiverCount;
        ++River
    )
    {
        int32 StartX =
            Random.RandRange(
                0,
                Settings.Width - 1
            );

        int32 StartY =
            Random.RandRange(
                0,
                Settings.Height - 1
            );

        if (
            Terrain[Index(StartX, StartY)]
                .Height > 0.70f
        )
        {
            GenerateRiverFromMountain(
                StartX,
                StartY
            );
        }
    }
}


void AMedievalWorldGenerator::GenerateRiverFromMountain(
    int32 StartX,
    int32 StartY
)
{
    int32 X = StartX;
    int32 Y = StartY;

    const int32 MaximumLength = 5000;

    for (
        int32 Step = 0;
        Step < MaximumLength;
        ++Step
    )
    {
        if (
            X < 0 ||
            Y < 0 ||
            X >= Settings.Width ||
            Y >= Settings.Height
        )
        {
            break;
        }

        FTerrainCell& Cell =
            Terrain[Index(X, Y)];

        Cell.bRiver = true;

        if (Cell.Height < 0.25f)
        {
            break;
        }

        float BestHeight =
            Cell.Height;

        int32 BestX = X;
        int32 BestY = Y;

        for (
            int32 DY = -1;
            DY <= 1;
            ++DY
        )
        {
            for (
                int32 DX = -1;
                DX <= 1;
                ++DX
            )
            {
                if (
                    DX == 0 &&
                    DY == 0
                )
                    continue;

                int32 NX =
                    X + DX;

                int32 NY =
                    Y + DY;

                if (
                    NX < 0 ||
                    NY < 0 ||
                    NX >= Settings.Width ||
                    NY >= Settings.Height
                )
                    continue;

                float H =
                    Terrain[
                        Index(NX, NY)
                    ].Height;

                if (H < BestHeight)
                {
                    BestHeight = H;
                    BestX = NX;
                    BestY = NY;
                }
            }
        }

        if (
            BestX == X &&
            BestY == Y
        )
        {
            break;
        }

        X = BestX;
        Y = BestY;
    }
}


// ============================================================
// SETTLEMENT LOCATIONS
// ============================================================

void AMedievalWorldGenerator::FindSettlementLocations()
{
    for (
        int32 Y = 2;
        Y < Settings.Height - 2;
        ++Y
    )
    {
        for (
            int32 X = 2;
            X < Settings.Width - 2;
            ++X
        )
        {
            FTerrainCell& Cell =
                Terrain[Index(X, Y)];

            Cell.bSettlementSuitable =
                IsSuitableForSettlement(
                    Cell
                );
        }
    }
}


bool AMedievalWorldGenerator::IsSuitableForSettlement(
    const FTerrainCell& Cell
) const
{
    if (
        Cell.Height < 0.35f ||
        Cell.Height > 0.72f
    )
        return false;

    if (
        Cell.Slope > 0.25f
    )
        return false;

    if (
        Cell.Fertility < 0.50f
    )
        return false;

    if (
        Cell.bRiver
    )
        return false;

    return true;
}


// ============================================================
// MULTI-OCTAVE NOISE
// ============================================================

float AMedievalWorldGenerator::Noise(
    float X,
    float Y,
    float Scale,
    int32 Octaves
) const
{
    float Result = 0.0f;

    float Amplitude = 1.0f;

    float Frequency = Scale;

    float Maximum = 0.0f;

    for (
        int32 Octave = 0;
        Octave < Octaves;
        ++Octave
    )
    {
        float Value =
            FMath::PerlinNoise2D(
                FVector2D(
                    X * Frequency,
                    Y * Frequency
                )
            );

        Result +=
            (Value * 0.5f + 0.5f)
            * Amplitude;

        Maximum += Amplitude;

        Amplitude *= 0.5f;

        Frequency *= 2.0f;
    }

    return
        Maximum > 0.0f
        ? Result / Maximum
        : 0.0f;
}


// ============================================================
// RIDGED NOISE
// ============================================================

float AMedievalWorldGenerator::RidgedNoise(
    float X,
    float Y,
    float Scale,
    int32 Octaves
) const
{
    float Result = 0.0f;

    float Amplitude = 1.0f;

    float Frequency = Scale;

    float Maximum = 0.0f;

    for (
        int32 Octave = 0;
        Octave < Octaves;
        ++Octave
    )
    {
        float Value =
            FMath::PerlinNoise2D(
                FVector2D(
                    X * Frequency,
                    Y * Frequency
                )
            );

        Value =
            1.0f -
            FMath::Abs(
                Value
            );

        Value *= Value;

        Result +=
            Value *
            Amplitude;

        Maximum +=
            Amplitude;

        Amplitude *=
            0.5f;

        Frequency *=
            2.0f;
    }

    return
        Result /
        Maximum;
}


