// ============================================================
// MAP TYPES
// ============================================================

UENUM(BlueprintType)
enum class EMedievalMapType : uint8
{
    GreenValley,
    HighlandKingdom,
    Riverlands,
    DeepForest,
    CoastalPlains
};


// ============================================================
// TERRAIN MATERIAL TYPES
// ============================================================

UENUM(BlueprintType)
enum class ETerrainMaterial : uint8
{
    DeepWater,
    ShallowWater,
    WetSand,
    Sand,
    Grass,
    RichGrass,
    Meadow,
    ForestFloor,
    RockyGround,
    Mountain,
    Snow
};


// ============================================================
// RESOURCE TYPES
// ============================================================

UENUM(BlueprintType)
enum class EMedievalResource : uint8
{
    None,
    Wood,
    Stone,
    Iron,
    Coal,
    Copper,
    Tin,
    Gold,
    Salt,
    Clay,
    Flax,
    Berries,
    Herbs,
    Fish,
    FertileSoil
};


// ============================================================
// TERRAIN CELL
// ============================================================

USTRUCT(BlueprintType)
struct FTerrainCell
{
    GENERATED_BODY()

    // World position
    UPROPERTY(BlueprintReadOnly)
    FVector WorldPosition = FVector::ZeroVector;

    // Height
    UPROPERTY(BlueprintReadOnly)
    float Height = 0.0f;

    // Normal
    UPROPERTY(BlueprintReadOnly)
    FVector Normal = FVector::UpVector;

    // Moisture
    UPROPERTY(BlueprintReadOnly)
    float Moisture = 0.0f;

    // Temperature
    UPROPERTY(BlueprintReadOnly)
    float Temperature = 0.0f;

    // Fertility
    UPROPERTY(BlueprintReadOnly)
    float Fertility = 0.0f;

    // Slope
    UPROPERTY(BlueprintReadOnly)
    float Slope = 0.0f;

    // Terrain material
    UPROPERTY(BlueprintReadOnly)
    ETerrainMaterial Material =
        ETerrainMaterial::Grass;

    // Resource
    UPROPERTY(BlueprintReadOnly)
    EMedievalResource Resource =
        EMedievalResource::None;

    // Forest density
    UPROPERTY(BlueprintReadOnly)
    float ForestDensity = 0.0f;

    // Is river?
    UPROPERTY(BlueprintReadOnly)
    bool bRiver = false;

    // Is road?
    UPROPERTY(BlueprintReadOnly)
    bool bRoad = false;

    // Is settlement suitable?
    UPROPERTY(BlueprintReadOnly)
    bool bSettlementSuitable = false;
};


// ============================================================
// WORLD SETTINGS
// ============================================================

USTRUCT(BlueprintType)
struct FMedievalWorldSettings
{
    GENERATED_BODY()

    // Map dimensions
    UPROPERTY(EditAnywhere)
    int32 Width = 2048;

    UPROPERTY(EditAnywhere)
    int32 Height = 2048;

    // Size of each terrain cell
    UPROPERTY(EditAnywhere)
    float CellSize = 100.0f;

    // Mountain intensity
    UPROPERTY(EditAnywhere)
    float MountainStrength = 1.0f;

    // Valley depth
    UPROPERTY(EditAnywhere)
    float ValleyStrength = 1.0f;

    // Forest density
    UPROPERTY(EditAnywhere)
    float ForestStrength = 1.0f;

    // River density
    UPROPERTY(EditAnywhere)
    float RiverStrength = 1.0f;

    // Resource density
    UPROPERTY(EditAnywhere)
    float ResourceStrength = 1.0f;

    // Seed
    UPROPERTY(EditAnywhere)
    int32 Seed = 12345;
};


