        AddBuilding(
            TEXT("Quarry"),
            TEXT("Extracts uncut stone.")
        );

        AddBuilding(
            TEXT("Stonecutter"),
            TEXT("Converts uncut stone into cut stone.")
        );

        AddBuilding(
            TEXT("Blacksmith"),
            TEXT("Produces swords, spears, halberds and pikes.")
        );

        AddBuilding(
            TEXT("Shieldwright"),
            TEXT("Produces large and small shields.")
        );

        AddBuilding(
            TEXT("Armourer"),
            TEXT("Produces helmets, mail and plate armour.")
        );

