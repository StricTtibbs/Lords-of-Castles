            TEXT("Watchtower"),
            TEXT("Provides a defensive observation position.")
        );

        AddBuilding(
            TEXT("Barracks"),
            TEXT("Houses and trains soldiers.")
        );

        AddBuilding(
            TEXT("Armoury"),
            TEXT("Stores military equipment.")
        );

        AddBuilding(
            TEXT("Castle Courtyard"),
            TEXT("Central area for the castle complex.")
