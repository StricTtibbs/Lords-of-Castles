// =============================================================
// START
// =============================================================

void UMedievalBuildingPanel::NativeConstruct()
{
    Super::NativeConstruct();


    // =========================================================
    // CONNECT BUTTONS
    // =========================================================

    if (IndustryButton)
    {
        IndustryButton->OnClicked.AddDynamic(
            this,
            &UMedievalBuildingPanel::OpenIndustry
        );
    }

    if (ResidentialButton)
    {
        ResidentialButton->OnClicked.AddDynamic(
            this,
            &UMedievalBuildingPanel::OpenResidential
        );
    }

    if (CommercialButton)
    {
        CommercialButton->OnClicked.AddDynamic(
            this,
            &UMedievalBuildingPanel::OpenCommercial
        );
    }

    if (CastleButton)
    {
        CastleButton->OnClicked.AddDynamic(
            this,
            &UMedievalBuildingPanel::OpenCastle
        );
    }

    if (RoadsButton)
    {
        RoadsButton->OnClicked.AddDynamic(
            this,
            &UMedievalBuildingPanel::OpenRoads
        );
    }
}


