// CLEAR LIST
// =============================================================

void UMedievalBuildingPanel::ClearBuildingList()
{
    if (BuildingList)
    {
        BuildingList->ClearChildren();
    }
}


// =============================================================
// ADD BUILDING
// =============================================================

void UMedievalBuildingPanel::AddBuilding(
    const FString& BuildingName,
    const FString& Description
)
{
    if (!BuildingList)
    {
        return;
    }


    UTextBlock* BuildingText =
        NewObject<UTextBlock>(
            this
        );


    FString Text =
        BuildingName +
        TEXT("\n") +
        Description;


    BuildingText->SetText(
        FText::FromString(Text)
    );


    BuildingText->SetAutoWrapText(
        true
    );


    FSlateFontInfo Font =
        BuildingText->GetFont();

    Font.Size = 18;

    BuildingText->SetFont(
        Font
    );


    UVerticalBoxSlot* Slot =
        BuildingList->AddChildToVerticalBox(
            BuildingText
        );


    if (Slot)
    {
        Slot->SetPadding(
            FMargin(
                10.0f,
                8.0f
            )
        );
    }
}


// =============================================================
// SHOW CATEGORY
// =============================================================

void UMedievalBuildingPanel::ShowCategory(
    const FString& CategoryName
)
{
    ClearBuildingList();


    // =========================================================
    // INDUSTRY
    // =========================================================

    if (CategoryName == TEXT("Industry"))
